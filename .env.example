# Service configuration only. Never put supplier API keys in the browser.
# The server does not load this file automatically: export variables or use uvicorn --env-file.
WORLDMIND_ENABLE_MODELS=0
WORLDMIND_LEDGER=var/model-ledger.sqlite3
# Independent replay storage; keep this path on persistent disk and back it up.
# Defaults: 7 days, 64 archives, 64 MiB recording payload total, 2 MB each.
# Active sessions remain in memory; restore opens a verified read-only replay.
WORLDMIND_ARCHIVES=var/replay-archives.sqlite3
WORLDMIND_REQUEST_LIMIT=100
WORLDMIND_HOSTS=localhost,127.0.0.1
# Models remain disabled until separately authorized and explicitly enabled.
WORLDMIND_MODEL_ACCESS=
# Required exact model ID from your own account; no guessed model names.
WORLDMIND_DEEPSEEK_MODEL=
WORLDMIND_DEEPSEEK_API_KEY=
WORLDMIND_MIMO_MODEL=
WORLDMIND_MIMO_API_KEY=
WORLDMIND_GEMINI_MODEL=
WORLDMIND_GEMINI_API_KEY=
# Other names: OPENAI, OPENAI_CHAT, ANTHROPIC, DOUBAO, QWEN, MOONSHOT, ZHIPU,
# SILICONFLOW, OPENROUTER, GROQ, MISTRAL, XAI, TOGETHER, AZURE, OLLAMA, VLLM.
# Each uses WORLDMIND_<NAME>_MODEL / _API_KEY / optional _ENDPOINT.
# AZURE and VLLM require explicit full _ENDPOINT; Gemini keeps {model} in its URL template.
# For identity-linked Anthropic keys: WORLDMIND_ANTHROPIC_WORKSPACE_ID
